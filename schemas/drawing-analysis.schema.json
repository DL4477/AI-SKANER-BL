{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drawing analysis draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.2.0-draft"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_review"
      ]
    },
    "ready_for_3d": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 240
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "kind": {
          "type": "string",
          "enum": [
            "pdf",
            "demo"
          ]
        }
      },
      "required": [
        "name",
        "page_count",
        "kind"
      ],
      "additionalProperties": false
    },
    "drawing_general": {
      "type": "object",
      "properties": {
        "part_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "designation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "material": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "units": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 80
        },
        "general_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200,
          "minItems": 0
        }
      },
      "required": [
        "part_name",
        "designation",
        "material",
        "units",
        "notes",
        "general_requirement_ids"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      },
      "maxItems": 200
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "summary": {
      "type": "string",
      "maxLength": 3000
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "maxItems": 80,
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "maxItems": 600,
      "minItems": 0
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "maxItems": 400,
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "maxItems": 300,
      "minItems": 0
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 600,
      "minItems": 0
    },
    "dimension_chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chain"
      },
      "maxItems": 100,
      "minItems": 0
    },
    "validation": {
      "type": "object",
      "properties": {
        "engine_version": {
          "type": "string",
          "maxLength": 40
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "maxItems": 5000,
          "minItems": 0
        },
        "scope": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "engine_version",
        "checks",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "status",
    "ready_for_3d",
    "source",
    "drawing_general",
    "surfaces",
    "questions",
    "summary",
    "views",
    "observations",
    "dimensions",
    "requirements",
    "bindings",
    "dimension_chains",
    "validation"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "page",
        "description",
        "bbox"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "projection",
            "section",
            "detail",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 16,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "description",
        "evidence"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "raw_text": {
          "type": "string",
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "enum": [
            "dimension",
            "requirement",
            "note",
            "symbol",
            "label",
            "unknown"
          ]
        },
        "view_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 8,
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "raw_text",
        "kind",
        "view_id",
        "alternatives",
        "evidence"
      ],
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "properties": {
        "dimension_id": {
          "type": "string",
          "maxLength": 80
        },
        "coefficient": {
          "type": "number"
        }
      },
      "required": [
        "dimension_id",
        "coefficient"
      ],
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200,
          "minItems": 0
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "designation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "basis": {
          "type": "string",
          "enum": [
            "read",
            "derived",
            "assumed",
            "unknown"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "diameter",
            "radius",
            "axial_length",
            "transverse_distance",
            "center_distance",
            "hole_depth",
            "thread_depth",
            "angle",
            "other",
            "unknown"
          ]
        },
        "axis": {
          "type": "string",
          "enum": [
            "axial",
            "transverse",
            "radial",
            "angular",
            "unknown"
          ]
        },
        "reference_description": {
          "type": "string",
          "maxLength": 1000
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          },
          "maxItems": 30,
          "minItems": 0
        },
        "derivation_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "required": [
        "id",
        "observation_ids",
        "name",
        "value",
        "unit",
        "designation",
        "basis",
        "role",
        "axis",
        "reference_description",
        "derived_from",
        "derivation_note"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": [
            "roughness",
            "dimensional_tolerance",
            "geometrical_tolerance",
            "it_grade",
            "heat_treatment",
            "coating",
            "other"
          ]
        },
        "raw_text": {
          "type": "string",
          "maxLength": 2000
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "it_grade": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200,
          "minItems": 0
        },
        "scope": {
          "type": "string",
          "enum": [
            "general",
            "local",
            "unknown"
          ]
        },
        "scope_description": {
          "type": "string",
          "maxLength": 1000
        },
        "dimension_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "kind",
        "raw_text",
        "value",
        "unit",
        "it_grade",
        "observation_ids",
        "scope",
        "scope_description",
        "dimension_ids"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "fact_id": {
          "type": "string",
          "maxLength": 80
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200,
          "minItems": 0
        },
        "property": {
          "type": "string",
          "enum": [
            "diameter",
            "radius",
            "axial_length",
            "transverse_distance",
            "center_distance",
            "hole_depth",
            "thread_depth",
            "angle",
            "other",
            "unknown",
            "technical_requirement"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "disputed"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 12,
          "minItems": 0
        },
        "target_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "fact_id",
        "surface_ids",
        "property",
        "status",
        "rationale",
        "alternatives",
        "target_evidence"
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "plane",
            "cylinder",
            "cone",
            "sphere",
            "torus",
            "freeform",
            "other",
            "unknown"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "outward",
            "inward",
            "unknown"
          ]
        },
        "boundary_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 16,
          "minItems": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 30
        },
        "physical_role": {
          "type": "string",
          "enum": [
            "cylindrical_side",
            "end_face",
            "shoulder_face",
            "slot_wall",
            "slot_floor",
            "hole_wall",
            "hole_bottom",
            "chamfer",
            "fillet",
            "groove",
            "other",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "orientation",
        "boundary_description",
        "evidence",
        "uncertainties",
        "physical_role"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "total_dimension_id": {
          "type": "string",
          "maxLength": 80
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          },
          "maxItems": 40,
          "minItems": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "required": [
        "id",
        "total_dimension_id",
        "terms",
        "description"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 80
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "not_checkable",
            "info"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 200,
          "minItems": 0
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "code",
        "severity",
        "entity_ids",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
